# ── XandSuite server environment ─────────────────────────────────────────────
# Copy this file to .env and adjust as needed.

# Run the backend without a GUI window (required for server mode).
XANDSUITE_HEADLESS=1

# Port the HTTP API server listens on (default: 3847).
# Change XANDSUITE_PORT in docker-compose to expose a different host port.
# XANDSUITE_PORT=3847

# Absolute path to the built React frontend (dist/).
# The API server serves these static files at /.
# XANDSUITE_FRONTEND_DIST=/app/dist

# Absolute path to the tools/ directory containing Python packages.
# XANDSUITE_TOOLS_DIR=/app/tools

# ── Optional API authentication ───────────────────────────────────────────────
# If set, every HTTP request must include: Authorization: Bearer <token>
# Leave empty to allow unauthenticated access (fine for a private LAN).
# XANDSUITE_API_TOKEN=

# ── Frontend (web build) ──────────────────────────────────────────────────────
# Compile-time default backend URL embedded in the web build.
# When set, the browser skips the "Connect to Server" screen.
# VITE_API_URL=http://your-server-ip:3847
