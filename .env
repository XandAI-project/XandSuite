# XandSuite Environment Variables
# Copy this file to .env.local and fill in your values

# HuggingFace API token (optional, for gated models)
HUGGINGFACE_API_TOKEN=

# Remote LLM server (optional)
REMOTE_LLM_SERVER_URL=
REMOTE_LLM_API_KEY=

# Feature flags
# Set to true to show the Coding workspace in the sidebar
VITE_ENABLE_CODING=false
